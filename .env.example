# Cấu hình lõi VieNeu-TTS
VIENEU_PRECISION=fp32
VIENEU_BACKEND=onnx
VIENEU_THREADS=4
SAMPLE_RATE=48000

# Nhận diện lời thoại mẫu tiếng Việt (STT)
STT_MODEL_ID=vinai/PhoWhisper-base

# Thư mục lưu trữ (nằm trọn trên ổ đĩa dự án, không lưu cache vào ổ C:)
HF_HOME=.hf_cache
TORCH_HOME=.hf_cache/torch
VOICES_DIR=voices
OUTPUTS_DIR=outputs
HISTORY_DIR=history

# Tách đoạn văn bản dài (số ký tự mục tiêu mỗi chunk)
MAX_CHARS_PER_CHUNK=220
PAUSE_MS_BETWEEN_CHUNKS=200

# Máy chủ FastAPI
HOST=127.0.0.1
PORT=8000
